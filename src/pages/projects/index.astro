---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Badge from '../../components/Badge.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
---
<BaseLayout title="Projects">
  <PageHeading title="Projects" intro="Things I've built and things I'm exploring." />
  <ul class="space-y-6">
    {projects.map((p) => (
      <li>
        <h2 class="text-lg font-semibold"><a href={`/projects/${p.id}`}>{p.data.title}</a> <Badge label={p.data.status} /></h2>
        <p class="mt-1 text-slate-600">{p.data.summary}</p>
        <p class="mt-2 flex flex-wrap gap-2">{p.data.tags.map((t) => <Badge label={t} />)}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
