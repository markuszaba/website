---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';

const books = await getCollection('reading');
const sections = [
  { key: 'reading', label: 'Currently reading' },
  { key: 'finished', label: 'Finished' },
  { key: 'want-to-read', label: 'Want to read' },
] as const;
const byDate = (a: (typeof books)[number], b: (typeof books)[number]) =>
  (b.data.finished ?? b.data.started ?? 0).valueOf() - (a.data.finished ?? a.data.started ?? 0).valueOf();
---
<BaseLayout title="Reading">
  <PageHeading title="Reading" intro="What I'm reading, what I've finished, and what's next. Add a file to src/content/reading/ to log a book." />
  {sections.map(({ key, label }) => {
    const items = books.filter((b) => b.data.status === key).sort(byDate);
    return items.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">{label}</h2>
        <ul class="space-y-3">
          {items.map((b) => (
            <li class="flex items-center gap-3">
              {b.data.cover && <Image src={b.data.cover} alt={`Cover of ${b.data.title}`} width={48} class="rounded shadow-sm" />}
              <div>
                <a href={`/reading/${b.id}`} class="font-medium">{b.data.title}</a>
                <span class="text-slate-500"> — {b.data.author}</span>
                {b.data.rating && <span class="ml-2 text-amber-500" aria-label={`${b.data.rating} out of 5`}>{'★'.repeat(b.data.rating)}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</BaseLayout>
