---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const books = await getCollection('reading');
  return books.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title}>
  <a href="/reading" class="text-sm">← Reading</a>
  <div class="mt-3 flex items-start gap-5">
    {entry.data.cover && <Image src={entry.data.cover} alt={`Cover of ${entry.data.title}`} width={160} class="rounded shadow" />}
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{entry.data.title}</h1>
      <p class="text-slate-500">{entry.data.author}{entry.data.rating ? ` · ${'★'.repeat(entry.data.rating)}` : ''}</p>
    </div>
  </div>
  <div class="prose prose-slate mt-6 max-w-none"><Content /></div>
</BaseLayout>
