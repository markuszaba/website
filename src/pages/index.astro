---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import { site } from '../data/site';

const reading = (await getCollection('reading', (b) => b.data.status === 'reading'));
const projects = (await getCollection('projects'))
  .filter((p) => p.data.status === 'in-progress' || p.data.status === 'exploring')
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const writing = (await getCollection('writing', (w) => !w.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<BaseLayout title={site.name}>
  <section class="mb-12">
    <h1 class="text-4xl font-bold tracking-tight">Hi, I'm {site.name}</h1>
    <p class="mt-3 text-lg text-slate-600">{site.tagline}</p>
    <p class="mt-4 flex gap-4 text-sm">
      <a href="/about" class="text-sky-600">About me →</a>
      <a href="/experience" class="text-sky-600">Experience →</a>
      <a href={site.resumeUrl} class="text-sky-600">Resume ↓</a>
    </p>
  </section>

  <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">Now</h2>
  <div class="grid gap-8 sm:grid-cols-2">
    <section>
      <h3 class="mb-2 font-semibold"><a href="/reading" class="no-underline hover:underline">Reading</a></h3>
      {reading.length === 0 ? <p class="text-sm text-slate-500">Nothing right now.</p> : (
        <ul class="space-y-1 text-sm">
          {reading.map((b) => <li>{b.data.title} <span class="text-slate-500">— {b.data.author}</span></li>)}
        </ul>
      )}
    </section>
    <section>
      <h3 class="mb-2 font-semibold"><a href="/projects" class="no-underline hover:underline">Working on</a></h3>
      {projects.length === 0 ? <p class="text-sm text-slate-500">Nothing right now.</p> : (
        <ul class="space-y-1 text-sm">
          {projects.map((p) => <li><a href={`/projects/${p.id}`}>{p.data.title}</a> <Badge label={p.data.status} /></li>)}
        </ul>
      )}
    </section>
  </div>

  <section class="mt-12">
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">Latest writing</h2>
    {writing.length === 0 ? <p class="text-sm text-slate-500">Nothing yet.</p> : (
      <ul class="space-y-3">
        {writing.map((w) => (
          <li>
            <a href={`/writing/${w.id}`} class="font-medium">{w.data.title}</a>
            <p class="text-sm text-slate-500">{w.data.date.toLocaleDateString('en-US', { dateStyle: 'medium' })} · {w.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
