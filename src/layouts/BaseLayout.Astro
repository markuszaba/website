---
import '../styles/global.css';
import { site, nav } from '../data/site';

const { title = site.name, description = site.tagline } = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-slate-200">
      <div class="flex max-w-5xl flex-wrap items-center justify-between gap-3 px-6 py-4">
        <a href="/" class="text-lg font-semibold no-underline">{site.name}</a>
        <nav class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'no-underline hover:text-sky-600',
                path.startsWith(item.href) ? 'font-semibold text-sky-600' : 'text-slate-600',
              ]}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="w-full max-w-5xl flex-1 px-6 py-10">
      <slot />
    </main>

    <footer class="border-t border-slate-200">
      <p class="max-w-5xl px-6 py-6 text-sm text-slate-500">© {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>
